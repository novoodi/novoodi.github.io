---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, summary, tags } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="page-head">
      <p class="eyebrow">
        <a href="/blog/">블로그</a> / <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      {tags.length > 0 && <TagList tags={tags} />}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="back"><a href="/blog/">← 글 목록</a></p>
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
  }
  .lead {
    margin-bottom: 1rem;
  }
  .back {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
