---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, period, kind, stack, award, cover } = project.data;
---

<article class="card">
  {
    cover && (
      <div class="cover">
        <Image src={cover} alt="" widths={[480, 800]} sizes="(min-width: 44rem) 26rem, 100vw" />
      </div>
    )
  }
  <div class="body">
    <p class="meta">{period} · {kind}</p>
    <h3>
      <a href={`/projects/${project.id}/`}>{title}</a>
    </h3>
    <p class="summary">{summary}</p>
    {award && <p class="award"><span class="badge">{award}</span></p>}
    <TagList tags={stack} max={4} />
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .cover {
    aspect-ratio: 2 / 1;
    background: var(--accent-soft);
    border-bottom: 1px solid var(--line);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    flex: 1;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
  }
  h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* 카드 전체를 눌러도 이동하게 합니다 */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .summary {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .award {
    margin: 0;
  }
</style>
