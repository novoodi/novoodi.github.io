---
interface Props {
  tags: string[];
  /** 지정하면 앞에서부터 이 개수만 보여 주고 나머지는 "+N"으로 줄입니다 */
  max?: number;
}

const { tags, max } = Astro.props;
const shown = max ? tags.slice(0, max) : tags;
const rest = tags.length - shown.length;
---

<ul class="tags">
  {shown.map((tag) => <li>{tag}</li>)}
  {rest > 0 && <li aria-label={`그 외 ${rest}개`}>+{rest}</li>}
</ul>
